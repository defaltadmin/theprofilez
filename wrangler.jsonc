{
  "name": "theprofilez",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "local": {
      "name": "theprofilez-local",
      "routes": [],
      "vars": {
        "PUBLIC_HOST": "localhost",
        "ADMIN_HOST": "admin.localhost",
        "ACCESS_TEAM_DOMAIN": "https://your-team.cloudflareaccess.com",
        "ACCESS_AUD": "replace-with-access-audience"
      },
      "d1_databases": [{
        "binding": "DB", "database_name": "theprofilez",
        "database_id": "00000000-0000-0000-0000-000000000000",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{"binding": "MEDIA", "bucket_name": "theprofilez-media"}],
      "unsafe": {"bindings": [{
        "name": "FORM_RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001",
        "simple": {"limit": 10, "period": 60}
      }]}
    }
  },
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_HOST": "theprofilez.com",
    "ADMIN_HOST": "admin.theprofilez.com",
    "ACCESS_TEAM_DOMAIN": "https://your-team.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-access-audience"
  },
  "routes": [
    {
      "pattern": "theprofilez.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.theprofilez.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "theprofilez",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "theprofilez-media"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "FORM_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ]
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}